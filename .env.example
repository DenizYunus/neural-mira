# =============================================================================
# Neural MIRA — config
# Copy this file to `.env` and fill in the values that apply to you.
# Anything left blank falls back to the defaults shown in comments.
# =============================================================================

# --- LLM (training-data synthesis only) --------------------------------------
# Required for the three scripts that synthesize training data:
#   - scripts/synthesize_whatsapp_diaries.py
#   - scripts/generate_training_queries.py
#   - scripts/generate_style_augmentations.py
#
# NOT required for training the attention head, evaluation, or inference —
# leave blank if you only want to train on diary entries you already have.
#
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Anthropic
# via openai-compatible proxy, NVIDIA NIM, vLLM, etc.). Default is OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=60000

# --- Paths -------------------------------------------------------------------
# Where YOUR data lives. Relative paths resolve against the repo root.
# See data/README.md for the expected file formats.

# Directory containing diary files. The scripts will pick up every `*.md`
# file directly inside (non-recursive). Override DIARY_FILES below to pin a
# specific subset.
DIARY_ROOT=./data/diaries

# Optional: comma-separated list of specific diary files to use. Paths
# without a leading `/` or drive letter resolve against DIARY_ROOT.
# Leave empty to auto-discover all `*.md` files in DIARY_ROOT.
DIARY_FILES=

# Where the feedback log lives. Used by scripts/convert_feedback.py to turn
# thumbs-up/down annotations into eval examples for the attention head.
# Default: ./data/feedback.jsonl (empty file if you have no feedback yet).
FEEDBACK_PATH=./data/feedback.jsonl

# Optional: directory of WhatsApp chat exports for the synthesis pipeline.
# Leave blank if you don't have WhatsApp data — the WhatsApp-side scripts
# will report "no data" and exit cleanly.
WHATSAPP_ROOT=
