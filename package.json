{
  "name": "memory-attention-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diary and WhatsApp temporal-emotional attention prototype for Jarvis memory retrieval.",
  "scripts": {
    "demo": "node src/diary_attention.mjs",
    "query": "node src/diary_attention.mjs",
    "generate:queries": "python3 scripts/generate_training_queries.py",
    "augment:styles": "python3 scripts/generate_style_augmentations.py",
    "train": "python3 scripts/train_htema.py",
    "search": "python3 scripts/search_htema.py",
    "evaluate": "python3 scripts/evaluate_htema.py",
    "baselines": "python3 scripts/evaluate_baselines.py",
    "honest:mira": "python3 scripts/honest_mira.py",
    "reconstruction:bench": "python scripts/reconstruction_benchmark.py",
    "synthetic:generate": "python benchmarks/mira_synthetic/generate.py",
    "synthetic:reconstruction": "python scripts/reconstruction_benchmark.py --diary-root benchmarks/mira_synthetic/generated/diaries --whatsapp-root benchmarks/mira_synthetic/generated/whatsapp --photo-metadata benchmarks/mira_synthetic/generated/photos/photo_metadata.jsonl --ground-truth-events benchmarks/mira_synthetic/generated/ground_truth/events.jsonl --target-dates-file benchmarks/mira_synthetic/generated/queries/reconstruction_targets.jsonl --query-mode date_plus_public_metadata --report benchmarks/mira_synthetic/generated/reconstruction_report.md --metrics benchmarks/mira_synthetic/generated/reconstruction_metrics.json --no-reflections",
    "mira:search": "python3 scripts/search_mira.py",
    "eval:gate": "python scripts/eval_gate.py",
    "reflect": "python3 scripts/reflect.py",
    "feedback:convert": "python3 scripts/convert_feedback.py",
    "neural:embed": "python3 scripts/build_neural_embeddings.py",
    "neural:train": "python3 scripts/train_neural_htema.py",
    "neural:search": "python3 scripts/search_neural_htema.py",
    "neural:evaluate": "python3 scripts/evaluate_neural_htema.py"
  },
  "engines": {
    "node": ">=20"
  }
}
